{
  "name": "space-app",
  "version": "1.0.0",
  "private": true,
  "description": "NASA の Astronomy Picture of the Day を表示する天体写真ビューア（Cloudflare Workers）",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./frontend/styles.css -o ./public/app.css --minify",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "figure": "node tools/build-observatory.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  }
}
